# Copy to .env.local for local overrides. All of these are optional.

# Force a city instead of detecting it from the domain
# (leamington | windsor | london).
# VITE_CITY=leamington

# Cloudinary unsigned upload preset used by the admin product editor
# (Cloudinary console → Settings → Upload → Upload presets → "Unsigned").
# Without it the admin can still paste image links.
# VITE_CLOUDINARY_CLOUD=dnb4uwcfy
# VITE_CLOUDINARY_PRESET=

# Use the local Firebase emulators instead of production.
# VITE_USE_EMULATORS=true
