rules_version = '2';

// Leamington Express — Firestore security rules
// Deploy with:  firebase deploy --only firestore:rules
//
// • Catalog (products, trips, settings): anyone can read, only admins write.
// • Orders are created only by the createOrder Cloud Function (prices and
//   stock are checked on the server). Customers can read their own orders.
// • Ride requests, travel bookings and contact messages: anyone may send a
//   well-formed request; only admins can read the list or change it.
// • Discount codes, private product data (cost, supplier) and the price rules
//   (express_pricing) are admin-only. express_catalog is a compact copy of the
//   products for the store, written only by the Cloud Functions.
// • Admins: the owner UID below, or anyone with a document in
//   express_admins/{uid} (created by the owner).
// • Employees (express_staff/{uid}, created from the admin): drivers, couriers
//   and trip guides. They see open jobs for what they're allowed to do
//   (rides / deliveries / trips), take them and update their progress — and
//   nothing else. They have no access to the admin data.
// • express_tracking/{token}: each customer's live-status page, readable by
//   whoever has the private link and written only by the Cloud Functions.
//   Its live/position document is the employee's location on the map: only the
//   employee doing that job writes it, and only while they're on the way.

service cloud.firestore {
  match /databases/{database}/documents {

    /* ----------------------------- who is who ----------------------------- */
    function signedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return signedIn() && request.auth.uid in ['FNTtxDJo1RbFw68eVcbkIFGGqza2'];
    }
    function isAdmin() {
      return isOwner() || (signedIn() && exists(/databases/$(database)/documents/express_admins/$(request.auth.uid)));
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Employees: an active express_staff/{uid} document, with what they may do
    function staffDoc() {
      return get(/databases/$(database)/documents/express_staff/$(request.auth.uid)).data;
    }
    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/express_staff/$(request.auth.uid)) && staffDoc().active == true;
    }
    function staffCan(skill) {
      return isStaff() && staffDoc().can[skill] == true;
    }
    // Only these fields may change in this update
    function changes(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }
    // The employee copied onto a job must be the one signed in
    function isMe(snapshot) {
      return snapshot is map && snapshot.uid == request.auth.uid;
    }

    /* ------------------------------ validators ----------------------------- */
    function text(v, max) {
      return v is string && v.size() <= max;
    }
    function filled(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function number(v, min, max) {
      return (v is int || v is float) && v >= min && v <= max;
    }
    function lang(v) {
      return v in ['es', 'en'];
    }
    // status, owner and server timestamps added by the website for new requests
    function newRequest(d, status) {
      return d.status == status
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && (d.userId == null || (signedIn() && d.userId == request.auth.uid));
    }
    function contact(c) {
      return c is map && filled(c.name, 2, 80) && filled(c.phone, 10, 15) && text(c.email, 120);
    }

    function validRide(d) {
      return d.keys().hasOnly(['ref', 'city', 'lang', 'pickup', 'dropoff', 'schedule', 'passengers', 'luggage', 'vehicle',
                               'options', 'stops', 'notes', 'contact', 'payment', 'estimate', 'status', 'userId', 'createdAt', 'updatedAt',
                               'trackToken', 'driverUid'])
        && newRequest(d, 'requested')
        && (!('trackToken' in d) || filled(d.trackToken, 16, 96))
        && (!('driverUid' in d) || d.driverUid == null)
        && filled(d.ref, 3, 20) && filled(d.city, 2, 40) && lang(d.lang)
        && d.pickup is map && text(d.pickup.address, 200)
        && d.dropoff is map && filled(d.dropoff.address, 2, 200)
        && d.schedule is map && d.schedule.type in ['now', 'later']
        && number(d.passengers, 1, 8) && number(d.luggage, 0, 10)
        && d.vehicle in ['standard', 'xl']
        && d.options is map
        && text(d.stops, 300) && text(d.notes, 500)
        && contact(d.contact)
        && d.payment in ['cash', 'card', 'etransfer']
        && (d.estimate == null || d.estimate is map);
    }

    function validBooking(d) {
      return d.keys().hasOnly(['ref', 'city', 'lang', 'channel', 'tripId', 'tripTitle', 'tripType', 'destination', 'date',
                               'departureTime', 'nights', 'adults', 'children', 'singleRoom', 'pricing', 'lead', 'travelers',
                               'requests', 'payPref', 'confirms', 'status', 'userId', 'createdAt', 'updatedAt',
                               'trackToken', 'guideUid'])
        && newRequest(d, 'pending')
        && (!('trackToken' in d) || filled(d.trackToken, 16, 96))
        && (!('guideUid' in d) || d.guideUid == null)
        && filled(d.ref, 3, 20) && filled(d.city, 2, 40) && lang(d.lang)
        && filled(d.tripId, 1, 120) && text(d.tripTitle, 200) && filled(d.date, 6, 20)
        && number(d.adults, 1, 60) && number(d.children, 0, 60)
        && d.pricing is map
        && contact(d.lead)
        && d.travelers is list && d.travelers.size() <= 60
        && text(d.requests, 1000)
        && d.payPref in ['etransfer', 'cash', 'card']
        && d.confirms is map;
    }

    function validMessage(d) {
      return d.keys().hasOnly(['name', 'phone', 'email', 'topic', 'message', 'city', 'lang', 'status', 'userId', 'createdAt', 'updatedAt'])
        && newRequest(d, 'new')
        && filled(d.name, 2, 80) && text(d.phone, 15) && text(d.email, 120)
        && (d.phone.size() >= 10 || d.email.size() >= 5)
        && d.topic in ['tienda', 'ride', 'viajes', 'grupo', 'otro']
        && filled(d.message, 5, 2000)
        && filled(d.city, 2, 40) && lang(d.lang);
    }

    // Customers can't give themselves points or admin rights
    function protectedProfileKeys() {
      return ['expressPoints', 'role', 'admin', 'isAdmin'];
    }

    /* ----------------------- employees taking jobs ----------------------- */
    // Rides: requested → assigned (taken) → arrived → in_progress → completed
    function rideAccept() {
      return staffCan('rides')
        && resource.data.driverUid == null && resource.data.status in ['requested', 'confirmed']
        && request.resource.data.driverUid == request.auth.uid
        && isMe(request.resource.data.driver)
        && request.resource.data.status == 'assigned'
        && changes(['driverUid', 'driver', 'status', 'assignedAt', 'updatedAt']);
    }
    function rideProgress() {
      let from = resource.data.status;
      let to = request.resource.data.status;
      return staffCan('rides')
        && resource.data.driverUid == request.auth.uid
        && request.resource.data.driverUid == request.auth.uid
        && changes(['status', 'arrivedAt', 'pickedUpAt', 'completedAt', 'updatedAt'])
        && ((from == 'assigned' && to in ['arrived', 'in_progress'])
            || (from == 'arrived' && to == 'in_progress')
            || (from == 'in_progress' && to == 'completed'));
    }
    function rideRelease() {
      return staffCan('rides')
        && resource.data.driverUid == request.auth.uid
        && resource.data.status in ['assigned', 'arrived']
        && request.resource.data.driverUid == null
        && request.resource.data.status == 'requested'
        && changes(['driverUid', 'driver', 'status', 'assignedAt', 'arrivedAt', 'updatedAt']);
    }

    // Deliveries (store orders): taken (Preparing) → Out for delivery → Fulfilled
    function deliveryAccept() {
      return staffCan('deliveries')
        && resource.data.courierUid == null && resource.data.status == 'Opened'
        && resource.data.get('fulfilment', 'Unfulfilled') in ['Unfulfilled', 'Preparing']
        // paid first (older cash orders are paid at the door)
        && (resource.data.get('paymentMethodKey', '') == 'cash' || resource.data.get('paymentMethod', '') == 'Cash' || resource.data.payment == 'Success')
        && resource.data.get('awaitingStock', false) != true // still being bought for the warehouse
        && request.resource.data.courierUid == request.auth.uid
        && isMe(request.resource.data.courier)
        && request.resource.data.fulfilment == 'Preparing'
        && changes(['courierUid', 'courier', 'courierAt', 'fulfilment', 'updatedAt']);
    }
    function deliveryProgress() {
      let from = resource.data.get('fulfilment', 'Unfulfilled');
      let to = request.resource.data.fulfilment;
      return staffCan('deliveries')
        && resource.data.courierUid == request.auth.uid
        && request.resource.data.courierUid == request.auth.uid
        && resource.data.status == 'Opened'
        && changes(['fulfilment', 'pickedUpAt', 'deliveredAt', 'payment', 'paidAt', 'updatedAt'])
        && ((from == 'Preparing' && to == 'Out for delivery') || (from == 'Out for delivery' && to == 'Fulfilled'))
        // a courier can only record cash they collected at the door
        && (request.resource.data.payment == resource.data.payment
            || (request.resource.data.payment == 'Success' && resource.data.get('paymentMethodKey', '') == 'cash' && to == 'Fulfilled'));
    }
    function deliveryRelease() {
      return staffCan('deliveries')
        && resource.data.courierUid == request.auth.uid
        && resource.data.get('fulfilment', 'Unfulfilled') in ['Unfulfilled', 'Preparing']
        && request.resource.data.courierUid == null
        && changes(['courierUid', 'courier', 'courierAt', 'updatedAt']);
    }

    // Trips: confirmed bookings → assigned (guide) → picked_up → completed
    function tripAccept() {
      return staffCan('trips')
        && resource.data.guideUid == null && resource.data.status in ['confirmed', 'deposit_paid', 'paid']
        && request.resource.data.guideUid == request.auth.uid
        && isMe(request.resource.data.guide)
        && request.resource.data.tripStage == 'assigned'
        && changes(['guideUid', 'guide', 'tripStage', 'guideAt', 'updatedAt']);
    }
    function tripProgress() {
      let from = resource.data.get('tripStage', '');
      let to = request.resource.data.tripStage;
      return staffCan('trips')
        && resource.data.guideUid == request.auth.uid
        && request.resource.data.guideUid == request.auth.uid
        && changes(['tripStage', 'pickedUpAt', 'completedAt', 'status', 'updatedAt'])
        && ((from == 'assigned' && to == 'picked_up' && request.resource.data.status == resource.data.status)
            || (from == 'picked_up' && to == 'completed' && request.resource.data.status == 'completed'));
    }
    function tripRelease() {
      return staffCan('trips')
        && resource.data.guideUid == request.auth.uid
        && resource.data.get('tripStage', '') == 'assigned'
        && request.resource.data.guideUid == null
        && request.resource.data.tripStage == ''
        && changes(['guideUid', 'guide', 'tripStage', 'guideAt', 'updatedAt']);
    }

    // Live map: the employee doing this job, while it's under way
    function sharesLive(token) {
      let t = get(/databases/$(database)/documents/express_tracking/$(token)).data;
      return isStaff() && t.get('staffUid', null) == request.auth.uid
        && ((t.kind == 'ride' && t.stage in ['assigned', 'arrived', 'in_progress'])
            || (t.kind == 'order' && t.stage == 'onTheWay'));
    }
    function validPosition(d) {
      return d.keys().hasOnly(['lat', 'lng', 'heading', 'speed', 'accuracy', 'at'])
        && number(d.lat, -90, 90) && number(d.lng, -180, 180)
        && (!('heading' in d) || d.heading == null || number(d.heading, 0, 360))
        && (!('speed' in d) || d.speed == null || number(d.speed, 0, 100))
        && (!('accuracy' in d) || d.accuracy == null || number(d.accuracy, 0, 100000))
        && d.at == request.time;
    }

    /* ------------------------------- catalog ------------------------------- */
    match /express_products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /express_products_private/{id} {
      allow read, write: if isAdmin();
    }
    match /express_trips/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /express_settings/{city} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // margin and price rules — admins only
    match /express_pricing/{doc} {
      allow read, write: if isAdmin();
    }
    // connections to other services (the BlueCart API key, the Walmart store) — admins only
    match /express_integrations/{doc} {
      allow read, write: if isAdmin();
    }
    // the store's compact copy of the catalog, built by the Cloud Functions
    match /express_catalog/{doc} {
      allow read: if true;
      allow write: if false;
    }

    /* -------------------------------- store -------------------------------- */
    match /express_orders/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (staffCan('deliveries') && resource.data.courierUid == request.auth.uid)
        || (staffCan('deliveries') && resource.data.courierUid == null && resource.data.status == 'Opened');
      allow create: if false; // only the createOrder Cloud Function
      allow update: if isAdmin() || deliveryAccept() || deliveryProgress() || deliveryRelease();
      allow delete: if isAdmin();
    }
    match /express_dicount_codes/{id} {
      allow read, write: if isAdmin();
    }

    /* ------------------------- rides, travel, contact ------------------------ */
    match /express_rides/{id} {
      allow create: if validRide(request.resource.data);
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (staffCan('rides') && resource.data.driverUid == request.auth.uid)
        || (staffCan('rides') && resource.data.driverUid == null && resource.data.status in ['requested', 'confirmed']);
      allow update: if isAdmin() || rideAccept() || rideProgress() || rideRelease();
      allow delete: if isAdmin();
    }
    match /express_travel_bookings/{id} {
      allow create: if validBooking(request.resource.data);
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (staffCan('trips') && resource.data.guideUid == request.auth.uid)
        || (staffCan('trips') && resource.data.guideUid == null && resource.data.status in ['confirmed', 'deposit_paid', 'paid']);
      allow update: if isAdmin() || tripAccept() || tripProgress() || tripRelease();
      allow delete: if isAdmin();
    }
    match /express_messages/{id} {
      allow create: if validMessage(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    /* ------------------------------ people ------------------------------ */
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && !request.resource.data.keys().hasAny(protectedProfileKeys());
      allow update: if isAdmin()
        || (isSelf(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedProfileKeys()));
      allow delete: if isAdmin();
    }
    match /express_admins/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isOwner();
    }
    match /express_staff/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, delete: if isAdmin(); // normally through the saveStaff / deleteStaff functions
      // employees only switch themselves on/off line
      allow update: if isAdmin()
        || (isSelf(uid) && resource.data.active == true
            && changes(['online', 'lastSeenAt', 'updatedAt']) && request.resource.data.online is bool);
    }

    /* ---------------------------- live status ---------------------------- */
    match /express_tracking/{token} {
      allow get: if true;           // whoever has the private link
      allow list, write: if false;  // written by the Cloud Functions only

      match /live/{doc} {
        allow get: if true;
        allow create, update: if doc == 'position' && sharesLive(token) && validPosition(request.resource.data);
        allow delete: if sharesLive(token);
      }
    }

    /* --------------------------- other apps --------------------------- */
    // Collections that belong to other apps in this Firebase project (for
    // example express_counters, written by the invoice app) keep the open
    // access they had before, so those apps don't break. Secure them once
    // those apps sign their users in.
    match /{collection}/{document=**} {
      allow read, write: if !(collection in ['express_products', 'express_products_private', 'express_trips', 'express_settings',
                                             'express_orders', 'express_dicount_codes', 'express_rides', 'express_travel_bookings',
                                             'express_messages', 'users', 'express_admins', 'express_staff', 'express_tracking',
                                             'express_pricing', 'express_catalog', 'express_integrations']);
    }
  }
}
